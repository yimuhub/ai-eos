# ============================================================================
# AI-EOS 环境变量模板
# 用法：复制为 apps/api/.env 后填入真实值
#   cp .env.example apps/api/.env
# 注意：.env 包含真实密钥，切勿提交到 git（已在 .gitignore 中排除）
# ============================================================================

# ---- 运行环境 ----
# development（默认，克隆下来就能跑）/ production（生产，安全不达标会拒绝启动）
AIEOS_ENV=development

# 调试模式：开发 true，生产必须 false
# DEBUG=false 时会一并关掉 /docs、/redoc、/openapi.json（过去匿名可下载完整 API 面）
DEBUG=true

# 是否逐条打印 SQL 语句与参数（SQLAlchemy echo）。与 DEBUG 无关，默认 false。
# 打开后调度器每次轮询都会写满日志，只适合本地排查一条慢查询时临时开。
# SQL_ECHO=true

# 全功能测试台开关：不填则跟随 DEBUG；生产环境请显式设 false
# ENABLE_FULL_FUNCTION_TEST_PAGE=false

# ---- 数据库与缓存 ----
# 便携模式默认 SQLite（数据文件在 data/ 下）；生产可用 PostgreSQL，例如：
# DATABASE_URL=postgresql+asyncpg://aieos:密码@localhost:5432/aieos
DATABASE_URL=sqlite+aiosqlite:///./data/aieos.db

# Redis（当前版本未深度使用，保留兼容）
REDIS_URL=redis://localhost:6379/0

# ---- 鉴权 ----
# JWT 签名密钥：留空也可以启动 —— 后端首次启动会自动生成一个随机密钥并保存到
# data/jwt_secret.key（与 SQLite 数据库同目录），后续启动复用它。
# ⚠️ 空密钥/默认密钥过去能让任何人伪造 token 拿到别人的数据，现在已堵死：
#    签发动作不再接受空值或内置占位值 aieos-portable-secret。
# 正式部署请显式配置一个随机长字符串，并像备份数据库一样备份密钥文件：
#   密钥文件丢失 = 所有已登录会话失效，全员重新登录
# 生成方式：openssl rand -hex 32
# 落盘位置可改：AIEOS_JWT_SECRET_FILE=/etc/aieos/jwt_secret.key
#   （目录只读/容器场景必须显式指定，否则后端只能退回进程内随机密钥，重启即失效）
JWT_SECRET=
JWT_ALGORITHM=HS256
# access token 有效期（分钟），默认 24 小时
JWT_EXPIRE_MINUTES=1440
# refresh token 有效期（天），默认 30 天，可吊销
JWT_REFRESH_EXPIRE_DAYS=30

# ---- 存储 ----
STORAGE_DIR=./storage
# 日志目录（按日轮转，保留 30 天）
AIEOS_LOG_DIR=./logs
# 知识库上传原件目录（默认 storage/kb-originals）
# AIEOS_KB_UPLOAD_DIR=
# Computer Agent 截屏目录（默认 storage/screenshots）
# AIEOS_SCREENSHOT_DIR=

# ---- 运维端点 ----
# /metrics/prometheus 的访问令牌（Prometheus 抓取用）：
#   留空      → DEBUG=false 时只允许本机回环地址抓取，其他来源返回 404
#   配了令牌  → 必须带 Authorization: Bearer <令牌>（或 ?token=<令牌>），否则 401
# 生成方式：openssl rand -hex 16
METRICS_TOKEN=

# ---- 后台任务 ----
# 任务/编排/工作流超时秒数（会议固定 600 秒）；默认 7200 秒 = 2 小时
AIEOS_TASK_TIMEOUT_S=7200
# 僵尸任务回收：RUNNING/PAUSED 超过多少分钟无心跳则标 FAILED，默认 30
AIEOS_STUCK_TASK_MINUTES=30

# ---- 模型服务 ----
# 专用文档转换大模型（低成本，可空）
DOC_CONVERT_MODEL_ID=

# OpenAI 兼容通道（默认指向 Agnes 中转，可换成任意 OpenAI 兼容地址）
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.agnes-ai.cn/v1
OPENAI_COMPAT_MODEL=

# 其他模型服务商（按需填写）
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- 前端（apps/web/.env.local）----
# 后端 API 地址，默认 http://localhost:8001
# NEXT_PUBLIC_API_URL=http://localhost:8001
