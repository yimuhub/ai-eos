# ============================================================================
# AI-EOS 环境变量模板
# 用法：复制为 apps/api/.env 后填入真实值
#   cp .env.example apps/api/.env
# 注意：.env 包含真实密钥，切勿提交到 git（已在 .gitignore 中排除）
# ============================================================================

# ---- 运行环境 ----
# development（默认，克隆下来就能跑）/ production（生产，安全不达标会拒绝启动）
AIEOS_ENV=development

# 调试模式：开发 true，生产必须 false（否则暴露堆栈与测试台）
DEBUG=true

# 全功能测试台开关：不填则跟随 DEBUG；生产环境请显式设 false
# ENABLE_FULL_FUNCTION_TEST_PAGE=false

# ---- 数据库与缓存 ----
# 便携模式默认 SQLite（数据文件在 data/ 下）；生产可用 PostgreSQL，例如：
# DATABASE_URL=postgresql+asyncpg://aieos:密码@localhost:5432/aieos
DATABASE_URL=sqlite+aiosqlite:///./data/aieos.db

# Redis（当前版本未深度使用，保留兼容）
REDIS_URL=redis://localhost:6379/0

# ---- 鉴权 ----
# JWT 签名密钥：本机试用可留空（用内置占位值）；生产环境必须换成随机长字符串
# 生成方式：openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
# access token 有效期（分钟），默认 24 小时
JWT_EXPIRE_MINUTES=1440
# refresh token 有效期（天），默认 30 天，可吊销
JWT_REFRESH_EXPIRE_DAYS=30

# ---- 存储 ----
STORAGE_DIR=./storage
# 日志目录（按日轮转，保留 30 天）
AIEOS_LOG_DIR=./logs
# 知识库上传原件目录（默认 storage/kb-originals）
# AIEOS_KB_UPLOAD_DIR=
# Computer Agent 截屏目录（默认 storage/screenshots）
# AIEOS_SCREENSHOT_DIR=

# ---- 后台任务 ----
# 任务/编排/工作流超时秒数（会议固定 600 秒）；默认 7200 秒 = 2 小时
AIEOS_TASK_TIMEOUT_S=7200
# 僵尸任务回收：RUNNING/PAUSED 超过多少分钟无心跳则标 FAILED，默认 30
AIEOS_STUCK_TASK_MINUTES=30

# ---- 模型服务 ----
# 专用文档转换大模型（低成本，可空）
DOC_CONVERT_MODEL_ID=

# OpenAI 兼容通道（默认指向 Agnes 中转，可换成任意 OpenAI 兼容地址）
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.agnes-ai.cn/v1
OPENAI_COMPAT_MODEL=

# 其他模型服务商（按需填写）
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- 前端（apps/web/.env.local）----
# 后端 API 地址，默认 http://localhost:8001
# NEXT_PUBLIC_API_URL=http://localhost:8001
