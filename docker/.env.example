# AI-EOS Docker 生产环境变量模板：cp .env.example .env 后填写
# compose v2 会自动加载本目录的 .env 做变量插值；api 服务也会经 env_file 读到它。
# 注意：.env 含密钥，切勿提交到 git。

# ---- PostgreSQL（必填）----
POSTGRES_USER=aieos
# 必填：请用 URL 安全字符（字母数字及 -_.~），勿用 @ / : # ? 等，否则 DATABASE_URL 解析失败
POSTGRES_PASSWORD=请改成随机长字符串
POSTGRES_DB=aieos

# ---- 后端鉴权（必填）----
# 生产环境 JWT_SECRET 绝不能留默认值，否则服务拒绝启动。生成：openssl rand -hex 32
JWT_SECRET=请改成随机长字符串
# 生产环境必须关闭调试
DEBUG=false
# 逐条打印 SQL（默认 false，与 DEBUG 无关；排查时才临时打开）
SQL_ECHO=false

# ---- 可选 ----
# 前端构建时写入的后端地址（浏览器直接访问后端时用宿主机地址）
NEXT_PUBLIC_API_URL=http://localhost:8001
AIEOS_ENV=production
